# Only for scripts/n8n.ts (terminal access to n8n). The app itself needs no env vars: each user logs in
# to their own n8n in the browser. Kept out of the repo root so Cloudflare's deploy wizard does not
# prompt for these values. Copy to .env.local (gitignored) or export in your shell. Never commit real values.
N8N_BASE=https://your-name.app.n8n.cloud
N8N_MCP_TOKEN=
