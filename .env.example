# Only for scripts/n8n.ts (terminal access to n8n). The app itself needs no env vars.
# Copy to .env.local (gitignored) or export in your shell. Never commit real values.
N8N_BASE=https://your-name.app.n8n.cloud
N8N_MCP_TOKEN=
# Optional, dev/preview proxy only: extra hosts the /mcp proxy may reach.
# N8N_ALLOWED_HOSTS=*.app.n8n.cloud,n8n.example.com
